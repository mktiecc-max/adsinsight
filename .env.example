# auto: dùng live khi đủ Supabase credentials, nếu không dùng demo.
# Có thể ép "demo" hoặc "live" theo môi trường triển khai.
ADSINSIGHT_DATA_MODE=auto

# Bỏ trống để chạy ở chế độ demo với dữ liệu mẫu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server. Hỗ trợ secret key mới hoặc service_role key cũ.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Google Service Account JSON đã mã hóa base64.
GOOGLE_SERVICE_ACCOUNT_B64=

# Tùy chọn: diễn giải AI. Khi bỏ trống, ứng dụng dùng bản diễn giải deterministic.
ANTHROPIC_API_KEY=

SYNC_CHUNK_SIZE=1000
SYNC_LOCK_TIMEOUT_MINUTES=15
